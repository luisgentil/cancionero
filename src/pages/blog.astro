---
import Base from '../layouts/Base.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Mi blog de aprendizaje de Astro";
---
<Base titulo={pageTitle}>

x
    <h1>Mi blog de Astro aprendizaje</h1>
    <p>Aquí es donde publicaré acerca de mi viaje aprendiendo Astro.</p>
    <ul>
      {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
    </ul>

</Base>