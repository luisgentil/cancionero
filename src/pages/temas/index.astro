---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

const canciones = await getCollection('canciones');
const temas = [...new Set(
  canciones.map(c => c.data.tema).filter(Boolean)
)].sort();
---
<Base titulo="Temas">
  <h1>Temas</h1>
  <ul>
    {temas.map(tema => (
      <li><a href={`/temas/${slugify(tema)}/`}>{tema}</a></li>
    ))}
  </ul>
</Base>