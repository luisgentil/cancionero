---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const canciones = await getCollection('canciones');
  const temas = [...new Set(canciones.flatMap(c => c.data.palabrasClave ?? []))];

  return temas.map(tema => ({
    params: { tema: slugify(tema) },
    props: {
      nombreTema: tema,
      canciones: canciones.filter(c => (c.data.palabrasClave ?? []).includes(tema)),
    },
  }));
}

const { nombreTema, canciones } = Astro.props;
---
<Base titulo={nombreTema}>
  <h1>Tema: {nombreTema}</h1>
  <ol>
    {canciones.map(c => (
      <li><a href={`/canciones/${c.id}/`}>{c.data.titulo}</a> — {c.data.autor}</li>
    ))}
  </ol>
</Base>